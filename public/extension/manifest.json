{
  "manifest_version": 3,
  "name": "StaffAdvantage Grade Filler",
  "version": "1.2.0",
  "description": "Extract StaffAdvantage student records and grades directly into Gradezy.",
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://staffadv.ncgrp.co.uk/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://staffadv.ncgrp.co.uk/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gradezy Assessment Assistant"
  },
  "externally_connectable": {
    "matches": [
      "https://gradezy-website.vercel.app/*",
      "http://localhost:3000/*"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
