{
  "manifest_version": 3,
  "name": "Gradezy — Assessment Companion",
  "version": "1.3.5",
  "description": "One local assessment workspace for Moodle, Excel, SharePoint and StaffAdvantage.",
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://staffadv.ncgrp.co.uk/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://staffadv.ncgrp.co.uk/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Open Gradezy workspace"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "externally_connectable": {
    "matches": [
      "https://gradezy-website.vercel.app/*",
      "http://localhost:3000/*"
    ]
  }
}
